# === Azure AD App Registration (Client Credentials Flow) ===
# NotificationService gửi thư qua Microsoft Graph và cần ba biến này. Để trống thì
# thư không gửi được — có ý, không phải thiếu sót.
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# === SharePoint Configuration ===
# Source (Input CRM_merge.xlsx from CRM-CTDA site)
SHAREPOINT_SOURCE_DRIVE_ID=b!K2h3C6y-m0-nfhBTKpRGUHVm2ajJ6j5Liiy5S410oj50hc-yscOEQrZMgUgL5YIr
SHAREPOINT_SOURCE_FILE_PATH=CRM_merge/CRM_merge.xlsx

# Target (Output Phân loại dữ liệu công trình dự án CRM V4.xlsx to DataPBI_salein site)
SHAREPOINT_TARGET_DRIVE_ID=b!NtlOjnoIAUGK2TSeHPN7wre_0vBaUZhHrpr9lFi7hWvJ-n1mRHXzSr4E9Qjzat5Q
SHAREPOINT_TARGET_FILE_PATH=Data Lake to SharePoint/Phan_Tich_CRM/Phân loại dữ liệu công trình dự án CRM V4.xlsx

# === Email Notification Configuration ===
NOTIFICATION_SENDER_EMAIL=sender@yourdomain.com
NOTIFICATION_RECIPIENTS=recipient1@domain.com,recipient2@domain.com

# === Google Gemini & Vertex AI Backend ===
# Đặt GEMINI_BACKEND=gateway để gọi qua API Gateway nội bộ (đường CHÍNH hiện nay).
# Bỏ biến này là lùi về hai nhánh cũ ngay, không phải sửa code; khi đó chọn tiếp
# bằng USE_VERTEX ở dưới.
#
# Khi chạy bằng Docker, ba biến GEMINI_BACKEND và GEMINI_GATEWAY_* đã được đặt sẵn
# trong docker-compose.override.yml nên không cần khai lại ở đây.
GEMINI_BACKEND=gateway
GEMINI_GATEWAY_BASE_URL=http://gateway-lb:4000
# Định danh DỊCH VỤ, không bịa ra một con người. Giá trị này vào cột `end_user`
# của sổ, nên điền bừa một cái tên sẽ làm hỏng chiều người dùng của dashboard.
GEMINI_GATEWAY_USER=svc.crm-feedback

# Khi GEMINI_BACKEND=gateway thì đây là VIRTUAL KEY của Gateway (sk-...), KHÔNG
# phải khoá Google. Key Google cho fallback được đặt riêng bên dưới.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# KHÔNG có tiền tố `models/`: Gateway khai tên nhóm là `gemini-2.5-flash`.
GEMINI_MODEL=gemini-2.5-flash

# Hai nhánh cũ, chỉ dùng tới khi bỏ GEMINI_BACKEND.
USE_VERTEX=True
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1

# === Đường DỰ PHÒNG khi Gateway chết ===
# Gateway mất kết nối liên tiếp đủ số lần thì gọi thẳng Google AI Studio.
# Không dùng Vertex hoặc sa-key.json. Các lượt này không có SpendLogs ở Gateway.
FALLBACK_ENABLED=False
# Key Google AI Studio thật, KHÔNG phải virtual key Gateway. Điền trong .env riêng.
# Thiếu key thì fallback bị tắt và ghi lỗi; tuyến chính qua Gateway vẫn chạy.
FALLBACK_API_KEY=
# Số lần hỏng LIÊN TIẾP trước khi đổi đường. PHẢI <= số lần thử lại bên trong một
# lô (call_llm_batch max_retry=3), nếu không thì lô ĐẦU TIÊN gặp sự cố vẫn bị bỏ.
# tests/test_fallback.py giữ giao kèo này.
FALLBACK_FAIL_THRESHOLD=3
# Chờ bao lâu rồi thăm dò Gateway để quay về, tính bằng giây.
FALLBACK_RETRY_AFTER_S=60

# === Rate Limiting & Performance settings ===
GEMINI_CONCURRENT_WORKERS=3
GEMINI_BATCH_SIZE=40
GEMINI_MIN_INTERVAL_S=7.5
GEMINI_JITTER_S=1.5
